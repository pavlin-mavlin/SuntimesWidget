<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    style="@style/SunsetTimeWidgetFrame1" android:id="@+id/widgetframe_outer_1x3">

    <LinearLayout android:id="@+id/widgetframe_inner"
        style="@style/SunsetTimeWidget" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center">

        <TextView style="@style/WidgetTitleTextView"
            android:id="@+id/text_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="start" android:visibility="gone"
            tools:text="title" />

        <TextView style="@style/WidgetTimeTextView"
            android:id="@+id/text_daylength"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="0dp" android:layout_marginBottom="0dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            tools:text="07:01:01" />

        <TextView style="@style/WidgetTimeTextView"
            android:id="@+id/text_daylength_delta"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="0dp" android:layout_marginBottom="0dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            tools:text="-3:13" />

    </LinearLayout>

</FrameLayout>
